{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app window is allowed to do. File access is limited to the app's own data folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "dialog:allow-ask",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
